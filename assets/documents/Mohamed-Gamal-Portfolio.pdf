               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Mohamed Gamal Mansour   About me  Self-motivated System Adminis</photoshop:LayerName>
                  <photoshop:LayerText>Mohamed Gamal Mansour   About me  Self-motivated System Administrator with over 15 years of extensive experience across various IT domains, including graphic design, print management, web development, and IT training. Proven track record of successfully mentoring and guiding over 8,000 interns in Egypt and abroad. Adept at both independent and collaborative work, consistently delivering outstanding results. </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Email: mohamed.gamal.m@gmail.com | Phone: 05 108 96610, 05 449 </photoshop:LayerName>
                  <photoshop:LayerText>Email: mohamed.gamal.m@gmail.com | Phone: 05 108 96610, 05 449 68675  |  LinkedIn: mohamed-gamal-07b7b968 | GitHub: sendoo-m </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Email: mohamed.gamal.m@gmail.com   Phone: 05 108 96610, 05 449 </photoshop:LayerName>
                  <photoshop:LayerText>Email: mohamed.gamal.m@gmail.com   Phone: 05 108 96610, 05 449 68675     LinkedIn: mohamed-gamal-07b7b968   GitHub: sendoo-m </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>05 108 96610</photoshop:LayerName>
                  <photoshop:LayerText>05 108 96610</photoshop:LayerText>
