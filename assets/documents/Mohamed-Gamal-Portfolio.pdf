         <photoshop:TextLayers>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>02</photoshop:LayerName>
                  <photoshop:LayerText>02</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Resume</photoshop:LayerName>
                  <photoshop:LayerText>Resume</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>@ Muhammad Gamal 2024</photoshop:LayerName>
                  <photoshop:LayerText>@ Muhammad Gamal 2024</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Graphic Design, Programmer, Trainer</photoshop:LayerName>
                  <photoshop:LayerText>Graphic Design, Programmer, Trainer</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Mohamed Gamal Mansour   About me  Self-motivated System Adminis</photoshop:LayerName>
                  <photoshop:LayerText>Mohamed Gamal Mansour   About me  Self-motivated System Administrator with over 15 years of extensive experience across various IT domains, including graphic design, print management, web development, and IT training. Proven track record of successfully mentoring and guiding over 8,000 interns in Egypt and abroad. Adept at both independent and collaborative work, consistently delivering outstanding results. </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Email: mohamed.gamal.m@gmail.com | Phone: 05 108 96610, 05 449 </photoshop:LayerName>
                  <photoshop:LayerText>Email: mohamed.gamal.m@gmail.com | Phone: 05 108 96610, 05 449 68675  |  LinkedIn: mohamed-gamal-07b7b968 | GitHub: sendoo-m </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Education:  Bachelor of Arabic Language â€“ Al-Azhar University, </photoshop:LayerName>
                  <photoshop:LayerText>Education:  Bachelor of Arabic Language â€“ Al-Azhar University, 2009 Diploma in Computer Science â€“ AskPc Academy, 2008 Graduate Diploma in Education, 2013</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Certifications  â€¢ Google: The Basics of Digital Marketing, 2019</photoshop:LayerName>
                  <photoshop:LayerText>Certifications  â€¢ Google: The Basics of Digital Marketing, 2019 â€¢ MCT: Microsoft Certified Trainer, 2013, 2017, 2018, 2021 â€¢ ICDL v4.0: International Computer Driving License, 2008 â€¢ Master MOS: Microsoft Office Specialist (Word, Excel, PowerPoint, Access), 2010 â€¢ A+ Vision: Maintenance, 2006 â€¢ CPSD: Certified Photoshop Designer, 2007 â€¢ ACWSD: Ask Pc Certified Website Designer, 2007 â€¢ Microsoft: MCSA Server 2012</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Web Development &amp; Design:  â€¢ Django-based Website Development â€¢</photoshop:LayerName>
                  <photoshop:LayerText>Web Development &amp; Design:  â€¢ Django-based Website Development â€¢ PHP, WordPress, Python Django â€¢ Front-end &amp; Back-end Web Development â€¢ Graphic Design &amp; Print Management </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Professional Experience  Technical Support Supervisor - Riyadh </photoshop:LayerName>
                  <photoshop:LayerText>Professional Experience  Technical Support Supervisor - Riyadh Season (2023 - 2024)  Led a team and managed technical support, ensuring seamless ticket booking operations on Webook.com.  System Administrator &amp; IT Trainer - Al-Manar Language School (2013 - 2023)  Managed system administration and provided IT training to over 8,000 interns. Designed and maintained the schoolâ€™s website and handled graphic design.  Print Manager &amp; IT Specialist - Digital Print Gate (2011 - 2012)  Managed print production and developed websites for clients.  Print Manager &amp; Graphic Designer - Al-Ahram Newspaper (2006 - 2008)  Directed the graphic and training department, overseeing print operations. </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Technical Skills  System Administration &amp; Technical Support: â€¢ </photoshop:LayerName>
                  <photoshop:LayerText>Technical Skills  System Administration &amp; Technical Support: â€¢ Microsoft Office (2013-2019) - Word, Excel, PowerPoint â€¢ Network Device Configuration (routers, switches, access points) â€¢ PC and Laptop Maintenance &amp; Troubleshooting (hardware/software) â€¢ Windows OS Troubleshooting (7, 8, 8.1, 10) â€¢ Antivirus Protection &amp; Security Management â€¢ CCTV Systems (DVR, NVR) â€¢ Fingerprint Systems Management â€¢ Printer Configuration &amp; Troubleshooting â€¢ Network Integration </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>2024</photoshop:LayerName>
                  <photoshop:LayerText>2024</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Graphic Design Programmer Trainer</photoshop:LayerName>
                  <photoshop:LayerText>Graphic Design Programmer Trainer</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Portfolio</photoshop:LayerName>
                  <photoshop:LayerText>Portfolio</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Graphic Design, Programmer, Trainer</photoshop:LayerName>
                  <photoshop:LayerText>Graphic Design, Programmer, Trainer</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Muhammad Gamal</photoshop:LayerName>
                  <photoshop:LayerText>Muhammad Gamal</photoshop:LayerText>
               </rdf:li>
            </rdf:Bag>
